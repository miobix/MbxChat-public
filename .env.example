# Copy this file to .env (compose needs it to exist) and fill in what you have.

# From Telegram's @BotFather (/newbot). Used from unit 1.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID: the only account the bot answers. Used from unit 1.
TELEGRAM_ALLOWED_USER_ID=

# Capture model (compose sets OLLAMA_URL to MbxRead's Ollama). CAPTURE_MODEL_ID is the digest
# prefix checked at startup; change both together after an eval.
# CAPTURE_MODEL=gemma4:e4b
# CAPTURE_MODEL_ID=dc35e8d9c606

# Optional: krdict Open API key (free: https://krdict.korean.go.kr/openApi/openApiInfo). Set, captures
# check rare words in the learners' dictionary (one request every 3 s, cached, paused 30 min after
# a failure); unset, no dictionary checks.
# KRDICT_API_KEY=

# Optional: a running MbxRead (sibling project). Set, the bot uses its library examples;
# unset, they are off. The bot runs in Docker, so use
# host.docker.internal here. The host importer (`python -m mbxchat.importer`) does not read this
# file: set MBXREAD_URL=http://127.0.0.1:8002 in that shell to import saved terms.
# MBXREAD_URL=http://host.docker.internal:8002

# AnkiConnect on the desktop (compose sets ANKI_URL to host.docker.internal). Chunk cards go to
# ANKI_DECK, created on first use.
# ANKI_URL=http://127.0.0.1:8765
# ANKI_DECK=MbxChat

# Practice pings (unit 5): IANA time zone and local ping times. Default UTC and 10/13/17/21.
# PRACTICE_TZ=Europe/Paris
# PRACTICE_PINGS=10:00,13:00,17:00,21:00

# Where the nightly backup service writes mbxchat-<date>.dump (newest 14 kept).
# BACKUP_DIR=./backups

# Optional: password for the compose Postgres (default "mbxchat"; it listens on 127.0.0.1 only).
# POSTGRES_PASSWORD=
